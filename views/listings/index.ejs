<% layout("layouts/boilerplate") %>

<!-- FILTERS -->
<div id="filters">
    <% const filters = [
        { name: "Trending",       icon: "fa-fire" },
        { name: "Rooms",          icon: "fa-bed" },
        { name: "Iconic Cities",  icon: "fa-mountain-city" },
        { name: "Mountains",      icon: "fa-mountain" },
        { name: "Amazing Pools",  icon: "fa-person-swimming" },
        { name: "Camping",        icon: "fa-campground" },
        { name: "Farms",          icon: "fa-tractor" },
        { name: "Arctic",         icon: "fa-snowflake" },
        { name: "Castles",        icon: "fa-chess-rook" },
        { name: "Domes",          icon: "fa-igloo" },
        { name: "Boats",          icon: "fa-sailboat" }
    ]; %>

    <% for (let f of filters) { %>
        <a
            href="/listings?category=<%= encodeURIComponent(f.name) %>"
            class="filter <%= (typeof category !== 'undefined' && category === f.name) ? 'active' : '' %>"
        >
            <div><i class="fa-solid <%= f.icon %>"></i></div>
            <p><%= f.name %></p>
        </a>
    <% } %>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch" />
            <label class="form-check-label" for="taxSwitch">Display total after taxes</label>
        </div>
    </div>
</div>

<!-- COUNTRY DROPDOWN -->
<form action="/listings" method="GET" class="mb-3 d-flex align-items-center gap-2">
    <% if (typeof category !== "undefined" && category) { %>
        <input type="hidden" name="category" value="<%= category %>" />
    <% } %>
    <% if (typeof q !== "undefined" && q) { %>
        <input type="hidden" name="q" value="<%= q %>" />
    <% } %>

    <label for="country" class="form-label mb-0">Country</label>
    <select
        name="country"
        id="country"
        class="form-select w-auto"
        onchange="this.form.submit()"
    >
        <option value="">All countries</option>
        <% for (let c of countries) { %>
            <option value="<%= c %>" <%= (typeof country !== "undefined" && country === c) ? "selected" : "" %>>
                <%= c %>
            </option>
        <% } %>
    </select>
</form>

<!-- LISTINGS -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% if (allListings.length === 0) { %>
        <p class="text-muted">
            <%= typeof q !== "undefined" && q ? `No listings found for "${q}".` : "No listings found for this filter." %>
        </p>
    <% } %>

    <% for (let listing of allListings) { %>

        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card listing-card">

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="listing_image"
                        style="height: 20rem"
                    />
                    <div class="card-img-overlay"></div>

                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b>
                            <br />
                            &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
                            <% if (listing.price) { %>
                                <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                            <% } %>
                        </p>
                    </div>

                </div>
            </a>
        </div>

    <% } %>

</div>

<script>
    const taxSwitch = document.getElementById("taxSwitch");
    if (taxSwitch) {
        taxSwitch.addEventListener("click", () => {
            for (let info of document.getElementsByClassName("tax-info")) {
                info.style.display = info.style.display !== "inline" ? "inline" : "none";
            }
        });
    }
</script>